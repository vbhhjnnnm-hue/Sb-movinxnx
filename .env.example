# ==============================================================================
# OBSIDIAN CINEMA - ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================

# Database Configuration (PostgreSQL / Prisma ORM)
# Required for PostgreSQL deployments. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/obsidian_cinema?schema=public"

# TMDB (The Movie Database) API Configuration
# CRITICAL SECURITY: Never expose this key in client-side code, React components, or public HTML.
# Used exclusively on the backend server for searching movies and retrieving posters/metadata.
TMDB_API_KEY=""

# Authentication & Session Security
# A 32+ character high-entropy secret string used for signing JWTs and session authentication cookies.
AUTH_SECRET="obsidian_secure_random_production_secret_key_change_me_in_production"

# Initial Administrator Credentials (Used for secure auto-initialization/seed)
# The first administrator account is provisioned with these credentials.
# The administrator can change their password immediately after first login.
ADMIN_EMAIL="admin@obsidiancinema.com"
ADMIN_INITIAL_PASSWORD="ObsidianAdmin2026!"

# Google AdSense Configuration (Policy-Compliant Integration)
# Publisher ID (e.g., ca-pub-XXXXXXXXXXXXXXXX) for policy-compliant ad units.
ADSENSE_PUBLISHER_ID="ca-pub-1234567890123456"

# Node Environment
NODE_ENV="development"
PORT="3000"
